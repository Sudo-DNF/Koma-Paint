[Desktop Entry]
Name=Koma Paint
Exec=komapaint %F
GenericName=Digital Painting
Comment=Paint, ink and draw comics with a studio-style workspace
Keywords=painting;drawing;comics;manga;illustration;sketch;
MimeType=application/x-krita;image/openraster;application/x-krita-paintoppreset;
Type=Application
Icon=komapaint
Categories=Qt;KDE;Graphics;2DGraphics;RasterGraphics;
X-KDE-NativeMimeType=application/x-krita
X-KDE-ExtraNativeMimeTypes=
StartupNotify=true
X-Krita-Version=28
StartupWMClass=komapaint
